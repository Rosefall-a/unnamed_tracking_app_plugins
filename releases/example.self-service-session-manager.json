        "permissions": [
          {
            "capability": {
              "name": "sessions.read",
              "version": 1
            },
            "rationale": "Read the signed-in user's sensitive IP address, user agent, approximate location, network/ASN, and session timestamps. This read grant does not authorize revocation."
          },
          {
            "capability": {
              "name": "sessions.revoke",
              "version": 1
            },
            "rationale": "DESTRUCTIVE, HIGH RISK: Revoke a browser session owned by the signed-in user after host confirmation. Revoking the current session signs the affected user out immediately; bulk operations cannot be undone."
          },
          {
            "capability": {
              "name": "sessions.admin.read",
              "version": 1
            },
            "rationale": "HIGH RISK: allow a host-authenticated administrator to inspect sensitive device, IP, location, network, and anomaly metadata for all users inside native Settings."
          },
          {
            "capability": {
              "name": "sessions.admin.revoke",
              "version": 1
            },
            "rationale": "DESTRUCTIVE, HIGH RISK: Allow an administrator to revoke another user's browser session after host confirmation. Revoking the current session signs the affected user out immediately; bulk operations cannot be undone."
          },
          {
            "capability": {
              "name": "backend.routes.plugin",
              "version": 1
            },
            "rationale": "Serve user and administrator session operations only below this plugin's authenticated route namespace."
          },
          {
            "capability": {
              "name": "frontend.settings",
              "version": 1
            },
            "rationale": "Contribute Sessions and administrator Session Manager sections to native host Settings."
          },
          {
            "capability": {
              "name": "frontend.native",
              "version": 1
            },
            "rationale": "CRITICAL: execute the official Vue session UI in the host to integrate Settings and the session map. Only install code you trust."
          },
          {
            "capability": {
              "name": "sessions.geoip.read",
              "version": 1
            },
            "rationale": "Allow administrators to inspect availability of optional City, Country and Network/ASN databases."
          },
          {
            "capability": {
              "name": "sessions.geoip.configure",
              "version": 1
            },
            "rationale": "DESTRUCTIVE, HIGH RISK: allow administrators to upload and replace host GeoIP databases after explicit confirmation."
          }
