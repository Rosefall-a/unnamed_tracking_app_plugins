              "name": "tasks.background",
              "version": 1
            },
            "rationale": "Run synchronization in the supervised plugin worker rather than a long UI action."
          },
          {
            "capability": {
              "name": "events.subscribe",
              "version": 1
            },
            "rationale": "Poll current-user host activity and persist a cursor after a successful sync."
          },
          {
