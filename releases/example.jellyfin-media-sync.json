              "name": "network.outbound",
              "version": 1
            },
            "rationale": "Contact only the configured Jellyfin server after a live grant check; redirects are refused."
          },
          {
            "capability": {
              "name": "frontend.native",
              "version": 1
            },
            "rationale": "Render native Vue configuration, write-only credential entry and progress using the host SDK."
