{
  "schema_version": "v1",
  "plugin_id": "example.jellyfin-media-sync",
  "title": "Jellyfin Media Sync",
  "settings": [
    {
      "id": "jellyfin",
      "title": "Jellyfin configuration",
      "description": "Use the same host account to enable and configure this installation. Save ordinary settings before submitting a token. Blank token entry keeps the stored token.",
      "fields": [
        {
          "id": "server_url",
          "label": "Jellyfin server URL",
          "type": "text",
          "required": true
        },
        {
          "id": "user_id",
          "label": "Jellyfin user ID (32 hexadecimal characters)",
          "type": "text",
          "required": true
        },
        {
          "id": "background_sync",
          "label": "Enable periodic sync for the enabling user",
          "type": "boolean",
          "default": false
        },
        {
          "id": "sync_interval_minutes",
          "label": "Sync interval in minutes",
          "type": "number",
          "default": 15,
          "validation": {
            "minimum": 5,
            "maximum": 1440
          }
        },
        {
          "id": "api_key",
          "label": "API key or access token (write-only)",
          "type": "password",
          "secret": true
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "save-token",
      "label": "Save token separately",
      "handler": "plugin:save_token",
      "capability": {
        "name": "plugin.storage",
        "version": 1
      }
    },
    {
      "id": "get-config",
      "label": "Read non-secret configuration",
      "handler": "plugin:get_config",
      "capability": {
        "name": "plugin.settings",
        "version": 1
      }
    },
    {
      "id": "sync-now",
      "label": "Queue sync for enabling user",
      "handler": "plugin:sync_now",
      "capability": {
        "name": "tasks.background",
        "version": 1
      }
    },
    {
      "id": "status",
      "label": "Refresh sync progress",
      "handler": "plugin:status",
      "capability": {
        "name": "plugin.storage",
        "version": 1
      }
    },
    {
      "id": "refresh-status",
      "label": "Poll host activity",
      "handler": "plugin:refresh_status",
      "capability": {
        "name": "events.subscribe",
        "version": 1
      }
    },
    {
      "id": "list-media",
      "label": "Preview your imported movies",
      "handler": "plugin:list_media",
      "capability": {
        "name": "media.read",
        "version": 1
      }
    }
  ],
  "tables": [],
  "dialogs": [],
  "menus": [
    {
      "id": "sync",
      "label": "Jellyfin Sync",
      "page_id": "sync"
    }
  ],
  "pages": [
    {
      "id": "sync",
      "title": "Jellyfin Media Sync",
      "description": "Syncs the enabling host user library. Host media.import currently supports movies and watched flags; full playback and provider identity require a generic API extension.",
      "settings": [
        "jellyfin"
      ],
      "actions": [
        "save-token",
        "get-config",
        "sync-now",
        "status",
        "refresh-status",
        "list-media"
      ],
      "tables": [],
      "dialogs": []
    }
  ],
  "extensions": [],
  "navigation": [
    {
      "id": "sync-sidebar",
      "location": "main.sidebar",
      "label": "Jellyfin Sync",
      "route_id": "sync-route",
      "order": 60
    },
    {
      "id": "sync-settings-link",
      "location": "settings.sidebar",
      "label": "Jellyfin Sync",
      "settings_section_id": "jellyfin-sync",
      "order": 60
    }
  ],
  "settings_sections": [
    {
      "id": "jellyfin-sync",
      "label": "Jellyfin Sync",
      "page_id": "sync",
      "order": 60
    }
  ],
  "routes": [
    {
      "id": "sync-route",
      "path": "sync",
      "page_id": "sync"
    }
  ]
}
