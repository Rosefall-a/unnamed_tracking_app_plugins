{
  "api_contract_version": "1.1.0",
  "schema_version": "v1",
  "plugin_id": "example.scoped-document-viewer",
  "title": "Scoped Document Viewer",
  "settings": [
    {
      "id": "viewer-settings",
      "title": "Viewer settings",
      "description": "Choose how much data the host will allow this reader to preview. Set the limit to 0 for no fixed preview-size limit.",
      "fields": [
        {
          "id": "max_preview_mb",
          "label": "Maximum preview size (MiB)",
          "type": "number",
          "description": "0 means unlimited. This controls the host-side preview limit; browser memory and renderer limits still apply.",
          "required": true,
          "secret": false,
          "default": 0,
          "options": [],
          "validation": {
            "minimum": 0
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "load-settings",
      "label": "Load viewer settings",
      "handler": "plugin:get_settings",
      "capability": {
        "name": "plugin.settings",
        "version": 1
      }
    },
    {
      "id": "list-documents",
      "label": "Refresh documents",
      "handler": "plugin:list_documents",
      "capability": {
        "name": "documents.read",
        "version": 1
      }
    },
    {
      "id": "read-document",
      "label": "Open document",
      "handler": "plugin:read_document",
      "capability": {
        "name": "documents.read",
        "version": 1
      }
    }
  ],
  "tables": [],
  "dialogs": [],
  "menus": [],
  "pages": [
    {
      "id": "documents",
      "title": "Documents",
      "description": "Game manuals, UTF-8 notes and sanitized HTML/XHTML, safely scoped to your account.",
      "settings": [
        "viewer-settings"
      ],
      "actions": [
        "list-documents",
        "read-document"
      ],
      "tables": [],
      "dialogs": [],
      "navigation": {
        "sidebar": false,
        "label": "Documents",
        "order": 40
      }
    },
    {
      "id": "reader-settings",
      "title": "Document reader settings",
      "description": "Configure safe previews and original downloads.",
      "settings": [
        "viewer-settings"
      ],
      "actions": [
        "load-settings"
      ]
    }
  ],
  "document_readers": [
    {
      "id": "game-documents",
      "page_id": "documents",
      "label": "Document reader",
      "extensions": [
        "*"
      ],
      "order": 0
    }
  ],
  "native_frontend": {
    "entry": "native/settings.js",
    "styles": [
      "native/style.css"
    ]
  },
  "settings_sections": [
    {
      "id": "reader-settings",
      "label": "Document reader",
      "page_id": "reader-settings",
      "order": 45,
      "visibility": {
        "admin_only": true
      }
    }
  ],
  "navigation": [
    {
      "id": "reader-settings-link",
      "location": "settings.sidebar",
      "label": "Document reader",
      "settings_section_id": "reader-settings",
      "order": 45,
      "visibility": {
        "admin_only": true
      }
    }
  ]
}
